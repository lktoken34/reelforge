{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reelforge:project:2.0-draft1",
  "title": "ReelForge foundation manifest; not a renderable scene language",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "seed",
    "output",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0-draft1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "fps"
      ],
      "properties": {
        "profile": {
          "enum": [
            "preview_360p",
            "target_720p"
          ]
        },
        "fps": {
          "enum": [
            24,
            25,
            30
          ],
          "type": "integer"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_frames",
          "intent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
